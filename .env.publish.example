# Copy to .env.publish (ignored by Git) to publish runs with scripts/publish_run.py.
# Environment variables take precedence over this file. See docs/infrastructure.md.

# The deployment's HTTP actions URL (ends in .convex.site, not .convex.cloud).
CONVEX_SITE_URL=

# Set only the secret for your own workstream. Each must equal the value set on the
# deployment with `npx convex env set INGEST_SECRET_<WORKSTREAM> ...`.
INGEST_SECRET_DECISION=
INGEST_SECRET_SWARM=
INGEST_SECRET_LAND=
