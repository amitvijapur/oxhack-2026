# Optional. Without it the website runs on the bundled static evidence.
# `npm run dev:backend` (npx convex dev) writes the real value to .env.local.
NEXT_PUBLIC_CONVEX_URL=

# Optional. A Google Maps Platform key with the Map Tiles API enabled switches the
# Earth to Google Photorealistic 3D Tiles. Without it the keyless globe is used.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
