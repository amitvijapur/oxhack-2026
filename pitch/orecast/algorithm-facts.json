  "name": "Orecast",
  "modelVersion": "tok-option-demo-v2",
  "sourceRevision": "fee2e0d4a3bf28c7825b2f0e8818d33c541a7ad7",
  "sourceUrl": "https://github.com/amitvijapur/oxhack-2026/tree/fee2e0d4a3bf28c7825b2f0e8818d33c541a7ad7",
  "formulas": {
    "support": "s = sum_group(weight_group * (mean_days3to5(event) - mean_days3to5(reference)) / 10)",
    "baselineGold": "P_base(t) = P0 * (1 + g)^(t / 365)",
    "goldResponse": "r_Au = goldResponseCap * s * exposure * retention",
    "scenarioGold": "P_scenario(t) = P_base(t) * (1 + r_Au)",
    "material": "G(t) = sum_i(Q_i * P_scenario_i(t)); only Au receives the response",
    "interest": "V_success(t) = ownership * kappa * G(t)",
    "assignment": "A(t) = pGeo * max(V_success(t) - buyerConsideration, 0)",
    "saleWeight": "w_j = (1-h)^(j-1) * h; j=1..horizonDays/30",
    "noSale": "P_no_sale = (1-h)^(horizonDays/30)",
    "cash": "E[cash] = sum_j(w_j * (A(30*j) - exitFee)) - premium - entryFee - unavoidableUpfrontObligations",
    "return": "expected option return = E[cash] / upfrontRisk; non-annualized",
    "change": "delta return in percentage points = 100 * (R_scenario - R_baseline)",
    "expiry": "horizonDays + 15 <= remainingMaturityDays"
  },
